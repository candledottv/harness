{
  "about": "Offline `candle swap` fast-path contracts (BE-3923): the job, wallet and decimals reads on the wire together; the order of outcomes unchanged; the embedded wallet's execute probe cached per API URL for 24 hours (a pass only); the local simulation read from the configured RPC and nothing else. Recorded by running the CLI's source against stand-ins from an exact staging commit; every fetch is intercepted. The commit is a staging build: the published CLI predates it.",
  "source": {
    "repo": "candledottv/candle-monorepo",
    "commit": "ebaf6b8838f81679e333994b3be2717be4cfa37d",
    "versions": {
      "cli": "0.13.31",
      "mcp": "0.10.36",
      "sdk": "0.6.25"
    },
    "files": [
      "packages/cli/src/commands/swap.ts",
      "packages/cli/src/trading.ts"
    ]
  },
  "rows": [
    {
      "id": "parallel-reads-tee-swap",
      "scenario": "parallel-reads",
      "evidence": "stand-in: each read is held until all three are on the wire; the recorder fails if one never arrives",
      "args": {
        "argv": [
          "swap",
          "SOL",
          "<tee>",
          "--amount",
          "1",
          "--yes",
          "--json",
          "--wallet",
          "tee",
          "--rpc-url",
          "<private-rpc>",
          "--client-trade-id",
          "fast-1"
        ]
      },
      "requests": [
        {
          "n": 1,
          "host": "api.test",
          "path": "/api/v1/agent/wallets/trading"
        },
        {
          "n": 2,
          "host": "rpc.private.test",
          "path": "<rpc>",
          "rpc": "getTokenSupply"
        },
        {
          "n": 3,
          "host": "api.test",
          "path": "/api/v1/trade/agent/jobs/fast-1"
        },
        {
          "n": 4,
          "host": "api.test",
          "path": "/api/v1/agent/wallets/embedded"
        },
        {
          "n": 5,
          "host": "api.test",
          "path": "/api/v1/trade/agent/build"
        },
        {
          "n": 6,
          "host": "rpc.private.test",
          "path": "<rpc>",
          "rpc": "getMultipleAccounts"
        },
        {
          "n": 7,
          "host": "rpc.private.test",
          "path": "<rpc>",
          "rpc": "simulateTransaction"
        },
        {
          "n": 8,
          "host": "api.test",
          "path": "/api/v1/agent/wallets/wallet/sign"
        },
        {
          "n": 9,
          "host": "api.test",
          "path": "/api/v1/trade/agent/submit"
        }
      ],
      "outcome": {
        "exitCode": 0,
        "readsStartedTogether": [
          "job",
          "wallets",
          "decimals"
        ],
        "readsBeforeBuild": 3,
        "builtAfterReads": true,
        "status": "executed"
      }
    },
