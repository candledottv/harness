{
  "about": "Offline Hyperliquid spot contracts (HM2, BE-3772) recorded from the published npm packages (@candledottv/agent-sdk 0.6.39, @candledottv/mcp 0.10.45, @candledottv/cli 0.13.47), not a monorepo checkout. sdk-run rows run the SDK's spot methods over an intercepted fetch (spot order `hide` without the echo is refused HIDE_NOT_CONFIRMED after the one build request, refusals send nothing); sdk-read rows run the positions and record readers on made-up bodies; package-text rows pin symbols in the shipped dist. Made-up ids only; no wallet address, key or account value; no fetch reached the network.",
  "packages": {
    "@candledottv/cli": {
      "version": "0.13.47",
      "integrity": "sha512-uLAExcASXpChLY6vJwzHsmkQb1AyfW2yE6B3aeq9UBNNOEsbEbcDt8O32rnNTQQl3huRu0hwE6EI6+yJtgLI5g=="
    },
    "@candledottv/mcp": {
      "version": "0.10.45",
      "integrity": "sha512-DzGN3F6HKd51JvCHTTIGPFVhlJ4ESPD7pzZBaqgZthbW2pa5brTQCyGbWVmgMs+CQTgmE5ydCkfWG/+Ssbar/A=="
    },
    "@candledottv/agent-sdk": {
      "version": "0.6.39",
      "integrity": "sha512-BZATsnpq0ZGSE0vBX/zwbY6DvC91u4G7Dtk0eHmNtDb5T2sGbCY8mUFPyvjNF2gxnKD6tV1i2h+3APRK4sc7DA=="
    }
  },
  "rows": [
    {
      "id": "sdk-spot-order-hide-without-echo-refused",
      "scenario": "sdk-run",
      "surface": "sdk",
      "args": {
        "method": "perpsSpotOrder",
        "market": "HYPE/USDC",
        "hide": true,
        "buildEchoesHide": false
      },
      "outcome": {
        "refused": {
          "code": "HIDE_NOT_CONFIRMED",
          "message": "perpsSpotOrder() asked for hide, but the API did not confirm it. Its server may predate hide, so the order may have been placed publicly. Check the order before"
        },
        "requests": [
          {
            "method": "POST",
            "path": "/api/v1/agent/perps/spot/order",
            "sendsHide": true
          }
        ]
      }
    },
    {
      "id": "sdk-spot-order-by-index-hide-without-echo-refused",
      "scenario": "sdk-run",
      "surface": "sdk",
      "args": {
        "method": "perpsSpotOrder",
        "market": "@107",
        "side": "sell",
        "hide": true
      },
      "outcome": {
        "refused": {
          "code": "HIDE_NOT_CONFIRMED",
          "message": "perpsSpotOrder() asked for hide, but the API did not confirm it. Its server may predate hide, so the order may have been placed publicly. Check the order before"
        },
        "requests": [
          {
            "path": "/api/v1/agent/perps/spot/order",
            "market": "@107",
            "sendsHide": true
          }
        ]
      }
    },
    {
      "id": "sdk-spot-order-without-hide-sends-no-hide-key",
      "scenario": "sdk-run",
      "surface": "sdk",
      "args": {
        "hide": "false or omitted"
      },
      "outcome": {
        "bodiesWithAHideKey": 0,
        "requests": 2
      }
    },
    {
      "id": "sdk-spot-refusals-send-nothing",
      "scenario": "sdk-run",
      "surface": "sdk",
      "args": {
        "cases": [
          "embeddedOrder",
          "embeddedBalances",
          "badSide",
          "badCloid"
        ]
      },
      "outcome": {
        "embeddedOrder": {
          "code": null,
          "message": "perpsSpotOrder(): Hyperliquid spot signs only from the key's EVM TEE wallet; the embedded wallet is not offered for spot. Nothing was requested."
        },
        "embeddedBalances": {
          "code": null,
          "message": "perpsSpotBalances(): Hyperliquid spot signs only from the key's EVM TEE wallet; the embedded wallet is not offered for spot. Nothing was requested."
        },
        "badSide": {
          "code": null,
          "message": "perpsSpotOrder(): side must be buy or sell"
        },
        "badCloid": {
          "code": null,
          "message": "perpsSpotCancel(): cloid must be 0x followed by 32 hex digits"
        },
        "requests": 0
      }
    },
    {
      "id": "sdk-spot-reads-paths",
