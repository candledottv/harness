    {
      "id": "sdk-tpsl-hidden-replacement-echoed",
      "scenario": "tpsl-run",
      "args": {
        "coin": "BTC",
        "stopLoss": "56000",
        "hide": true,
        "echoAttachHide": true
      },
      "outcome": {
        "complete": true,
        "signs": 2,
        "builds": [
          {
            "path": "/api/v1/agent/perps/tpsl",
            "operation": "cancel",
            "hasHideKey": false,
            "hide": null
          },
          {
            "path": "/api/v1/agent/perps/tpsl",
            "operation": "attach",
            "hasHideKey": true,
            "hide": true
          }
        ],
        "steps": [
          {
            "kind": "cancel",
            "status": "confirmed"
          },
          {
            "kind": "attach",
            "status": "confirmed"
          }
        ],
        "remainingTriggerPx": [
          "56000"
        ]
      }
    },
    {
      "id": "sdk-tpsl-hidden-attach-without-echo-refused",
      "scenario": "tpsl-run",
      "args": {
        "coin": "BTC",
        "takeProfit": "66000",
        "hide": true,
        "echoAttachHide": false
      },
      "outcome": {
        "complete": false,
        "signs": 1,
        "builds": [
          {
            "path": "/api/v1/agent/perps/tpsl",
            "operation": "cancel",
            "hasHideKey": false,
            "hide": null
          },
          {
            "path": "/api/v1/agent/perps/tpsl",
            "operation": "attach",
            "hasHideKey": true,
            "hide": true
          }
        ],
        "steps": [
          {
            "kind": "cancel",
            "status": "confirmed"
          },
          {
            "kind": "attach",
            "status": "rejected",
            "detail": "HIDE_NOT_CONFIRMED: the API did not echo hide: true. This step was not signed."
          }
        ],
        "remainingTriggerPx": []
      }
    },
