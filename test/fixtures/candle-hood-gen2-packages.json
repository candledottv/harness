    {
      "id": "sdk-hood-refusals-send-nothing",
      "scenario": "hood-refusal",
      "surface": "sdk",
      "args": {
        "cases": [
          "wrapper",
          "unknownRule",
          "unknownTeamKey",
          "creatorFeeOver",
          "feeStack"
        ]
      },
      "outcome": {
        "wrapper": {
          "code": "VALIDATION_FAILED",
          "message": "Send Hood generation 2 options as top-level fields (launchRules, snipeExempt, feeWallet, creatorFeeBps, teamAllocation), not hoodGen2Options."
        },
        "unknownRule": {
          "code": "VALIDATION_FAILED",
          "message": "launchRules.notARule is not a launch rule."
        },
        "unknownTeamKey": {
          "code": "VALIDATION_FAILED",
          "message": "teamAllocation.bogus is not a teamAllocation field."
        },
        "creatorFeeOver": {
          "code": "VALIDATION_FAILED",
          "message": "creatorFeeBps must be a whole number from 0 to 9999."
        },
        "feeStack": {
          "code": "VALIDATION_FAILED",
          "message": "the curve fee, creator fee and sniper fee at its peak must total under 100%"
        },
        "requests": 0
      }
    },
